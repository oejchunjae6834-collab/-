# 디적디적 환경 변수 예시
# 실제 사용 시 .env로 복사한 뒤 값을 채워주세요. (Render에서는 대시보드에서 입력)

# ─── 필수: Supabase ────────────────────────────────────────────────
# Supabase Settings → Database → Connection string (URI / Transaction pooler 권장)
DATABASE_URL="postgresql://postgres.xxxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Supabase Settings → API
SUPABASE_URL="https://xxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ─── 필수: 인증 ────────────────────────────────────────────────────
# 세션 쿠키 서명용 — 아무 긴 랜덤 문자열 (Render는 generateValue로 자동 생성)
SESSION_SECRET="change-this-to-a-long-random-string"

# 외부에서 접근 가능한 사이트 주소 — 매직링크 URL 만들 때 사용
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── 메일 발송 ──────────────────────────────────────────────────────
# 매직링크 발신 이름. Resend 도메인 인증 전엔 "onboarding@resend.dev" 권장
EMAIL_FROM="onboarding@resend.dev"

# Resend API 키 — https://resend.com/api-keys
# 비워두면 매직링크가 서버 콘솔에만 출력됩니다 (개발 모드)
# RESEND_API_KEY="re_xxxxxxxxxxxx"

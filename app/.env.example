# 디적디적 환경 변수 예시
# 실제 사용 시 .env 로 복사한 뒤 값 채우기 (Render는 대시보드에서 직접 입력)

# ─── 필수 ────────────────────────────────────────────────────────
# 세션 쿠키 서명용 — 아무 긴 랜덤 문자열 (Render는 generateValue로 자동 생성)
SESSION_SECRET="change-this-to-a-long-random-string"

# 매직링크 메일에 표시되는 발신자
# Resend 도메인 인증 전: "onboarding@resend.dev"
# 인증 후: "디적디적 <noreply@yourdomain.com>"
EMAIL_FROM="onboarding@resend.dev"

# 외부에서 접근 가능한 사이트 주소 — 매직링크 URL에 들어갑니다
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── 배포 시 추가 ────────────────────────────────────────────────
# DB 파일 경로 (Render Disk 마운트 경로)
# DB_PATH="/var/data/dijeokdijeok.db"

# 업로드된 사진 저장 경로 (Render Disk 마운트 경로)
# UPLOAD_DIR="/var/data/uploads"

# Resend API 키 — https://resend.com/api-keys
# 비워두면 매직링크가 서버 콘솔에만 출력됩니다 (개발 모드)
# RESEND_API_KEY="re_xxxxxxxxxxxx"
